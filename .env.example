# Autocosm — local development environment.
#
# Copy to `.env` and adjust. Every value here is safe to commit: Autocosm never uses a Storage
# account key, connection string or SAS token, and Azure OpenAI is reached with managed identity.
# If you find yourself wanting to add a secret to this file, that is a design bug — see
# docs/security.md.
#
# Variables are validated once at startup by a Zod schema per app (apps/*/src/config.ts).
# An unknown or malformed value fails the process immediately instead of at the first request.

# ---------------------------------------------------------------------------------------------
# Shared
# ---------------------------------------------------------------------------------------------

# development | test | production. `production` enables several hard refusals (see below).
NODE_ENV=development

# error | warn | info | debug
AUTOCOSM_LOG_LEVEL=info

# Identifier of the world this process operates on. One deployment, one world, for the MVP.
AUTOCOSM_WORLD_ID=autocosm

# Seed for world generation. The same seed always produces the same biosphere.
AUTOCOSM_WORLD_SEED=4242424

# memory | azureTables. `memory` is for local development and tests only; production refuses it.
AUTOCOSM_STORAGE_DRIVER=memory

# Table endpoint. Production must be the normal account endpoint reached through the private
# endpoint, e.g. https://stautocosmabc123.table.core.windows.net
# Local Azurite (development only): http://127.0.0.1:10002/devstoreaccount1
AZURE_TABLE_ENDPOINT=

# Client ID of the user-assigned managed identity for THIS workload. Set per Container App /
# Job by Bicep so DefaultAzureCredential is never ambiguous. Leave empty locally.
AZURE_CLIENT_ID=

# ---------------------------------------------------------------------------------------------
# web  (apps/world-web)
# ---------------------------------------------------------------------------------------------

HOST=0.0.0.0
PORT=8080

# Absolute path to the compiled browser bundle. Unset means "do not serve static files", which is
# what you want when running `npm run dev` (Vite serves the client and proxies /api).
AUTOCOSM_STATIC_ROOT=

# Development only. When there is no bundle to serve, `/` shows a signpost pointing at the Vite
# client instead of a bare JSON 404. `npm run dev` sets this automatically; production ignores it.
AUTOCOSM_DEV_CLIENT_URL=

# Signs the anonymous creator cookie. Any 16+ character string. When unset a random key is
# generated per process, so creator identity does not survive a restart. This is prototype
# identity, not account ownership — see README.
AUTOCOSM_CREATOR_SIGNING_KEY=

# Seconds a regional snapshot may be cached. Keep small; the world moves.
AUTOCOSM_SNAPSHOT_CACHE_SECONDS=2

# Abuse quotas, per creator per rolling day.
AUTOCOSM_MAX_AGENTS_PER_DAY=3
AUTOCOSM_MAX_GOALS_PER_DAY=6

# Blanket request rate limit, per IP per minute.
AUTOCOSM_RATE_LIMIT_PER_MINUTE=240

# Maximum accepted request body. Creation and goal payloads are tiny.
AUTOCOSM_MAX_BODY_BYTES=16384

# Seeds an empty world on web startup. Local development ONLY: production startup fails if this
# is enabled, because seeding writes authoritative world state.
AUTOCOSM_ALLOW_LOCAL_SEEDING=true

# ---------------------------------------------------------------------------------------------
# tick  (apps/world-tick) — one bounded, idempotent world advance, then exit
# ---------------------------------------------------------------------------------------------

# Simulated ticks one wall-clock minute represents. The job is scheduled every minute.
AUTOCOSM_TICKS_PER_MINUTE=4

# Hard ceiling on ticks advanced in a single execution, however far behind the world is. The
# remainder is left for the next run rather than timing out mid-tick.
AUTOCOSM_MAX_TICKS_PER_RUN=60

# Wall-clock budget for one execution.
AUTOCOSM_TICK_BUDGET_MS=45000

# Tick lease TTL. MUST exceed AUTOCOSM_TICK_BUDGET_MS, or the lease could expire mid-run and a
# second execution could double-apply a tick. Startup refuses a smaller value.
AUTOCOSM_TICK_LEASE_MS=90000

# Event compaction. 0 disables it.
AUTOCOSM_EVENT_RETENTION_TICKS=20000
AUTOCOSM_MAX_EVENTS_COMPACTED=500

# Generate the world if it is absent. Safe here: tick is the authoritative writer.
AUTOCOSM_SEED_IF_MISSING=true

# ---------------------------------------------------------------------------------------------
# think  (apps/agent-think) — claim a bounded batch of decisions, then exit
# ---------------------------------------------------------------------------------------------

# heuristic | azure-openai
# `heuristic` is deterministic, free, offline, and keeps the world fully alive. It is the default
# so the repository builds, tests and runs with no Azure OpenAI deployment at all.
AUTOCOSM_DECISION_PROVIDER=heuristic

# Required only when AUTOCOSM_DECISION_PROVIDER=azure-openai. Endpoint and deployment name are
# configuration, not secrets — authentication is managed identity.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# Cost ceilings. These are the knobs that decide the monthly bill.
AUTOCOSM_MAX_DECISIONS_PER_RUN=12
AUTOCOSM_MAX_DECISIONS_PER_DAY=400
AUTOCOSM_MIN_TICKS_BETWEEN=30
AUTOCOSM_MAX_COMPLETION_TOKENS=320
AUTOCOSM_MODEL_MAX_RETRIES=1
AUTOCOSM_MAX_DECISION_ATTEMPTS=3
AUTOCOSM_DECISION_TIMEOUT_MS=12000
AUTOCOSM_THINK_BUDGET_MS=50000

# ---------------------------------------------------------------------------------------------
# Container entrypoint
# ---------------------------------------------------------------------------------------------

# web | tick | think | seed. Normally supplied as the container argument instead.
AUTOCOSM_MODE=web
