{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist-types",
    "noEmit": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": [],
    "moduleResolution": "bundler",
    "module": "ESNext",
    "composite": false,
    "allowImportingTsExtensions": false,
    "verbatimModuleSyntax": true
  },
  "references": [{ "path": "../../packages/domain" }],
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
